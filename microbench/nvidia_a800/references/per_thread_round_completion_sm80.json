{
  "reference": "per_thread_round_completion_sm80",
  "hardware_id": "nvidia_a800",
  "architecture": "sm_80",
  "measures": "Completion time of one CTA-wide dependent source round in which every thread issues the declared number of global loads of the declared width. Rounds are strictly serialized; loads inside a round are independent and coalesced. grid 1.",
  "timer_domain": "globaltimer_same_cta",
  "load_encoding": "LDG.E.*.CONSTANT",
  "load_encoding_provenance": "rms_norm_kernel declares input and weight const __restrict__ and the production binary issues LDG.E.U16.CONSTANT; the probe reproduces that encoding. fused_add_rms_norm_kernel<bf16,8> updates input and residual in place and issues plain LDG.E.128 for those streams, which is outside this probe's declared encoding domain.",
  "rounds_per_trial": 512,
  "trials": 5,
  "prime": "full untimed walk of every stream's window before timing",
  "l2_window_bytes": 16777216,
  "l1_window_bytes": 65536,
  "residency_semantics": {
    "l2": "every stream reads the 16 MiB window: L1 miss, L2 hit",
    "l1": "every stream reads the 64 KiB window the CTA retains in L1",
    "mixed": "stream A from the L1 window, stream B from the L2 window"
  },
  "consumes_production_duration": false,
  "source_path": "microbench/nvidia_a800/memory/lsu/per_thread_round_completion.cu",
