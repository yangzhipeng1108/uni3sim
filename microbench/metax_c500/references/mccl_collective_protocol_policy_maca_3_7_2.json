  "timer_domain": "mctracer_uninstrumented_kernel_duration",
  "unit": "microseconds",
  "allowed_use": "Collective startup of one MCCL protocol band on a two-rank MetaXLink C500, for the ProtoBridge development profile's protocol policy. It is the span of the collective kernel itself on the rank that reached the collective last; the wait the earlier rank absorbs is rank skew, which the execution timeline represents separately by serialising ranks, and must not be folded into this constant.",
  "production_or_evaluation_duration_consumed": false,
  "derivation": "one unknown per protocol band, the band's collective startup, solved by bisection so the published ProtoBridge development model reproduces the measured per-collective duration at that band's smallest swept message; every other model input is the hardware record's own declared value",
  "rank_selection": "per size, the minimum across ranks of that rank's median kernel span, which is the rank that reached the collective last and therefore did not wait",
  "published": {
    "small_startup_us": 6.392,
    "ll128_startup_us": 10.52,
    "simple_startup_us": null
  },
  "published_from": "all_reduce",
  "not_resolved": {
    "simple_startup_us": "The sweep reaches one simple-band cell, 8,388,608 B, and the model over-predicts it by 34.2% with the startup driven to zero, so no non-negative startup reproduces it. The residual is in the band's bandwidth term, which this extraction holds fixed at the hardware record's declared value, so the constant is left unmeasured and the residual is reported rather than absorbed.",
    "phase_fixed_us": "A two-rank FC2 collective carries one phase, so this sweep constrains startup and the per-phase term only as their sum. The per-phase terms are therefore held at the hardware record's declared values and the startup carries the measured difference; separating them needs a four-rank sweep."
  },
  "independent_cross_check": {
    "operation": "all_gather",
    "small_startup_us": 6.636,
    "ll128_startup_us": 12.556,
    "note": "An independent all_gather sweep of the same deployment reproduces the small band within 3.8% and the LL128 band within 19.4%; the published values come from all_reduce, which is the operation the deployment issues 97 times per decode step."
  },
