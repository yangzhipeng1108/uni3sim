{
 "schema": "cyclic_reuse_replacement_residency_reference_v1",
 "mechanism": "cyclic_reuse_replacement_residency",
 "hardware_id": "metax_c500",
 "allowed_use": "Evidence for this target's L2 replacement residency against footprint: where a cyclically re-read working set stops being retained, and how sharply.  Supports the l2_replacement_capacity_bytes value, which is currently a fallback to the nominal L2 size with no measurement behind it.",
 "forbidden_use": "Any duration.  Not a DRAM bandwidth, not an associativity value, and not a per-shape traffic correction.  The curve must not be fitted or interpolated into a predictor.",
 "production_or_evaluation_duration_consumed": false,
 "instrument": "mcProfiler perf_exec --custom --per-kernel, one marker window, one numbered per-invocation file per ordinal",
 "counters": [
  "Global Memory Read bytes",
  "L2C Hit Rate"
 ],
 "geometry": {
  "workers": 104,
  "passes": 4,
  "block_threads": 256,
  "addressing": "disjoint contiguous per-worker partitions, read in address order",
  "nominal_l2_mib": 8.0
 },
 "why_independent_axes": "Under a fully associative LRU the answer is a step: a footprint at or below the replacement capacity costs one compulsory pass, anything above costs every pass.  Sweeping only the footprint, at a fixed worker count, pass count and addressing, therefore locates the capacity and exposes how far the real cache departs from that ideal.",
 "finding": "The realised pass count is 1.00 to 1.01 from 0.5 through 4 MiB, 1.33 at 6 MiB, 2.43 at 8 MiB, 3.45 at 10 MiB, 3.87 at 12 MiB and 4.00 from 16 MiB upward, against 4 passes issued. The 50 percent degradation point sits at about 8 MiB, so the nominal size is the right replacement capacity to within this sweep's resolution.  The transition is not the ideal step: retention already costs 33 percent extra at 6 MiB and is not fully lost until 12 to 16 MiB. Below 4 MiB retention is complete, so reuse at short distances is not degraded at all.",
 "build": {
  "compiler": "/opt/maca/mxgpu_llvm/bin/mxcc",
  "flags": "-x maca -offload-arch native --maca-path=/opt/maca -O3",
